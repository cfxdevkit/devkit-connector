# Conflux Core Configuration
CONFLUX_CORE_RPC_URL=https://main.confluxrpc.com
CONFLUX_CORE_TESTNET_RPC_URL=https://test.confluxrpc.com

# API Keys for Contract Verification
CONFLUX_CORE_API_KEY=your_core_api_key_here
CONFLUX_CORE_TESTNET_API_KEY=your_core_testnet_api_key_here

# Private Key for Deployment
PRIVATE_KEY=your_private_key_here

# Gas Reporting
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Network Configuration
CHAIN_ID=1029
TESTNET_CHAIN_ID=1
