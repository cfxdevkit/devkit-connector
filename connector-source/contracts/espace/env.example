# Conflux eSpace Configuration
CONFLUX_ESPACE_RPC_URL=https://evm.confluxrpc.com
CONFLUX_ESPACE_TESTNET_RPC_URL=https://evmtestnet.confluxrpc.com

# API Keys for Contract Verification
CONFLUX_ESPACE_API_KEY=your_espace_api_key_here
CONFLUX_ESPACE_TESTNET_API_KEY=your_espace_testnet_api_key_here

# Private Key for Deployment
PRIVATE_KEY=your_private_key_here

# Gas Reporting
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Network Configuration
CHAIN_ID=1030
TESTNET_CHAIN_ID=71
