# Database Configuration
DATABASE_URL=postgresql://conflux_user:conflux_password@localhost:5432/conflux_wallet
REDIS_URL=redis://localhost:6379

# Security Configuration
JWT_SECRET=your-jwt-secret-key-here
WALLET_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here
NEXTAUTH_SECRET=your-nextauth-secret-here

# Server Wallet Configuration (Option A)
ENCRYPTED_WALLET_MNEMONIC=your-encrypted-mnemonic-string-here

# RPC Endpoints
NEXT_PUBLIC_CONFLUX_ESPACE_RPC=https://evm.confluxrpc.com
NEXT_PUBLIC_CONFLUX_CORE_RPC=https://main.confluxrpc.com
CONFLUX_ESPACE_TESTNET_RPC=https://evmtestnet.confluxrpc.com
CONFLUX_CORE_TESTNET_RPC=https://test.confluxrpc.com

# External Services (Optional)
ALCHEMY_API_KEY=your-alchemy-key-here
INFURA_PROJECT_ID=your-infura-project-id-here

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Monitoring (Optional)
ENABLE_METRICS=true
ENABLE_TRACING=true

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Webhook Configuration (Optional)
WEBHOOK_SECRET=your-webhook-secret-here
