{
  "name": "conflux-dual-wallet",
  "version": "1.0.0",
  "description": "Production-ready Conflux Dual Wallet System with server-managed and user-delegated operation modes",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:migrate": "cd packages/database && pnpm run migrate",
    "db:seed": "cd packages/database && pnpm run seed",
    "db:reset": "cd packages/database && pnpm run reset",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "k8s:deploy": "kubectl apply -f infrastructure/kubernetes/",
    "k8s:delete": "kubectl delete -f infrastructure/kubernetes/",
    "contracts:compile": "cd contracts && pnpm run compile",
    "contracts:deploy": "cd contracts && pnpm run deploy",
    "contracts:test": "cd contracts && pnpm run test",
    "codegen": "cd tools/codegen && pnpm run generate",
    "cli": "cd tools/cli && pnpm run cli",
    "web-components:build": "cd packages/web-components && npm run build",
    "web-components:dev": "cd packages/web-components && npm run dev",
    "demos:test": "./scripts/test-demos.sh",
    "demos:pattern-a": "cd apps/demo-app && npm run dev",
    "demos:pattern-b": "cd apps/demo-app && npm run dev",
    "mocks:build": "cd packages/mocks && npm run build",
    "mocks:dashboard": "cd packages/mocks && npm run generate-dashboard",
    "mocks:progress": "cd packages/mocks && npm run track-progress",
    "node:start": "cd tools/node-manager && npm run start",
    "node:stop": "cd tools/node-manager && npm run stop",
    "node:dev": "cd tools/node-manager && npm run dev",
    "contracts:deploy:local": "cd tools/node-manager && npm run deploy-contracts",
    "contracts:test:local": "cd tools/node-manager && npm run test-contracts",
    "wrapper:exec": "cd tools/node-manager && npm run exec",
    "wrapper:deploy": "cd tools/node-manager && npm run deploy",
    "wrapper:call": "cd tools/node-manager && npm run call",
    "wrapper:flow": "cd tools/node-manager && npm run flow",
    "wrapper:test": "cd tools/node-manager && npm run test-wrapper",
    "dev:setup": "./scripts/dev-environment.sh all",
    "dev:start": "./scripts/dev-environment.sh start",
    "dev:stop": "./scripts/dev-environment.sh stop",
    "dev:reset": "./scripts/dev-environment.sh reset",
    "dev:deploy": "./scripts/dev-environment.sh deploy",
    "dev:test": "./scripts/dev-environment.sh test",
    "server:start": "cd packages/server && npm run start",
    "server:build": "cd packages/server && npm run build",
    "server:test": "node scripts/test-server-contracts.js",
    "server:dev": "cd packages/server && npm run dev",
    "web:start": "cd apps/demo-app && npm run dev",
    "web:build": "cd apps/demo-app && npm run build",
    "web:test": "node scripts/test-web-contracts.js",
    "web:contracts": "cd apps/demo-app && npm run dev",
    "orchestrate": "node scripts/orchestrator.js",
    "orchestrate:start": "node scripts/orchestrator.js start",
    "orchestrate:stop": "node scripts/orchestrator.js stop",
    "orchestrate:deploy": "node scripts/orchestrator.js deploy",
    "orchestrate:test": "node scripts/orchestrator.js test",
    "orchestrate:restart": "node scripts/orchestrator.js restart",
    "dev:orchestrate": "node scripts/dev.js start",
    "dev:test": "node scripts/dev.js test",
    "dev:stop": "node scripts/dev.js stop",
    "deploy": "node scripts/deploy.js deploy",
    "deploy:local": "node scripts/deploy.js deploy localEspace",
    "deploy:testnet": "node scripts/deploy.js deploy confluxEspaceTestnet",
    "deploy:mainnet": "node scripts/deploy.js deploy confluxEspace",
    "deploy:clean": "node scripts/deploy.js clean",
    "deploy:test": "node scripts/deploy.js test"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@xcfx/node": "^0.6.0",
    "axios": "^1.5.0",
    "chalk": "^5.6.2",
    "cive": "^0.1.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.3",
    "turbo": "^1.10.12",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.10.0"
}
