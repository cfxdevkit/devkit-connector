// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  username          String?  @unique
  passwordHash      String?
  authProvider      String?  // 'email', 'google', 'github', etc.
  authProviderId    String?  // External provider user ID
  emailVerified     Boolean  @default(false)
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastLogin         DateTime?
  status            String   @default("active") // 'active', 'suspended', 'deleted'
  metadata          Json?

  // Relations
  sessions          UserSession[]
  serverWallets     ServerWallet[]
  delegationSessions DelegationSession[]
  operations        WalletOperation[]
  securityEvents    SecurityEvent[]
  analytics         UserAnalytics[]
  notifications     Notification[]
  webhookEndpoints  WebhookEndpoint[]
  encryptedBackups  EncryptedBackup[]
  recoveryCodes     RecoveryCode[]

  @@map("users")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  deviceInfo   Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  lastActivity DateTime @default(now())
  isActive     Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model ServerWallet {
  id                String   @id @default(cuid())
  userId            String
  encryptedMnemonic String
  encryptionIv      String
  encryptionMethod  String   @default("aes-256-cbc")
  eSpaceAddress     String
  coreAddress       String
  derivationPath    String   @default("m/44'/60'/0'/0/0")
  networkId         Int      @default(1029)
  walletVersion     Int      @default(1)
  backupStatus      String   @default("pending") // 'pending', 'completed', 'failed'
  backupLocation    String?
  createdAt         DateTime @default(now())
  lastAccessed      DateTime?
  accessCount       Int      @default(0)
  status            String   @default("active") // 'active', 'locked', 'archived'

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLogs ServerWalletAccessLog[]
  operations WalletOperation[]

  @@map("server_wallets")
}

model ServerWalletAccessLog {
  id           String   @id @default(cuid())
  walletId     String
  userId       String
  accessType   String   // 'load', 'sign_transaction', 'sign_message'
  ipAddress    String?
  userAgent    String?
  success      Boolean
  errorMessage String?
  timestamp    DateTime @default(now())
  requestData  Json?

  wallet ServerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("server_wallet_access_log")
}

model DelegationSession {
  id                  String   @id @default(cuid())
  userId              String?
  userWalletAddress   String
  eSpaceAddress       String
  coreAddress         String
  signatureProof      String
  delegationMessage   String
  createdAt           DateTime @default(now())
  expiresAt           DateTime
  lastActivity        DateTime @default(now())
  autoRenew           Boolean  @default(false)
  maxRenewals         Int      @default(0)
  currentRenewals     Int      @default(0)
  status              String   @default("active") // 'active', 'expired', 'revoked', 'suspended'
  revokedAt           DateTime?
  revokedReason       String?
  config              Json
  configHash          String?
  ipAddress           String?
  userAgent           String?
  deviceFingerprint   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  events DelegationSessionEvent[]
  operations WalletOperation[]
  autoApprovalRules AutoApprovalRule[]
  webhookEndpoints WebhookEndpoint[]

  @@map("delegation_sessions")
}

model DelegationSessionEvent {
  id          String   @id @default(cuid())
  sessionId   String
  eventType   String
  eventData   Json
  triggeredBy String?
  ipAddress   String?
  timestamp   DateTime @default(now())

  session DelegationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("delegation_session_events")
}

model WalletOperation {
  id                    String   @id @default(cuid())
  userId                String
  walletId              String?
  sessionId             String?
  walletType            String   // 'server_managed', 'user_delegated'
  operationType         String
  chainType             String   // 'eSpace', 'core'
  status                String   @default("pending")
  operationPayload      Json
  operationResult       Json?
  errorDetails          Json?
  requiresUserApproval  Boolean  @default(false)
  autoApprovalRuleId    String?
  userApprovedAt        DateTime?
  approvedBy            String?
  approvalSignature     String?
  gasEstimate           BigInt?
  gasUsed               BigInt?
  gasPrice              BigInt?
  transactionHash       String?
  blockNumber           BigInt?
  confirmationCount     Int      @default(0)
  createdAt             DateTime @default(now())
  approvedAt            DateTime?
  executedAt            DateTime?
  completedAt           DateTime?
  ipAddress             String?
  userAgent             String?
  riskScore             Decimal?
  fraudCheckResult      Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet ServerWallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
  session DelegationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  stateChanges OperationStateChange[]
  ruleApplications RuleApplication[]

  @@map("wallet_operations")
}

model OperationStateChange {
  id            String   @id @default(cuid())
  operationId   String
  fromStatus    String?
  toStatus      String
  reason        String?
  changedBy     String?
  changedAt     DateTime @default(now())
  additionalData Json?

  operation WalletOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("operation_state_changes")
}

model AutoApprovalRule {
  id              String   @id @default(cuid())
  sessionId       String
  ruleName        String?
  ruleDescription String?
  ruleType        String
  conditionType   String
  conditionValue  Json
  autoApprove     Boolean
  priority        Int      @default(100)
  chainSpecific   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  usageCount      Int      @default(0)
  lastUsed        DateTime?

  session DelegationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  applications RuleApplication[]

  @@map("auto_approval_rules")
}

model RuleApplication {
  id           String   @id @default(cuid())
  ruleId       String
  operationId  String
  sessionId    String
  ruleMatched  Boolean
  ruleResult   String   // 'approved', 'rejected', 'skipped'
  matchDetails Json?
  appliedAt    DateTime @default(now())

  rule AutoApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  operation WalletOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("rule_applications")
}

model SecurityEvent {
  id                    String   @id @default(cuid())
  userId                String?
  sessionId             String?
  walletId              String?
  eventType             String
  severity              String   // 'low', 'medium', 'high', 'critical'
  eventData             Json
  automaticActionTaken  String?
  resolutionStatus      String   @default("open") // 'open', 'investigating', 'resolved', 'false_positive'
  resolvedAt            DateTime?
  resolvedBy            String?
  createdAt             DateTime @default(now())
  ipAddress             String?
  userAgent             String?
  locationData          Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_events")
}

model RateLimit {
  id           String   @id @default(cuid())
  userId       String?
  sessionId    String?
  limitType    String   // 'operations_per_hour', 'transactions_per_day', 'value_per_day'
  limitValue   BigInt
  currentUsage BigInt   @default(0)
  resetAt      DateTime
  createdAt    DateTime @default(now())

  @@map("rate_limits")
}

model DailyStatistics {
  statDate       DateTime @id
  metricType     String   @id
  metricCategory String?  @id
  metricValue    BigInt
  additionalData Json?

  @@map("daily_statistics")
}

model UserAnalytics {
  id                      String   @id @default(cuid())
  userId                  String
  analysisDate            DateTime
  totalOperations         Int      @default(0)
  successfulOperations    Int      @default(0)
  failedOperations        Int      @default(0)
  averageTransactionValue Decimal?
  preferredChain          String?
  preferredWalletType     String?
  mostActiveHour          Int?
  mostActiveDay           Int?
  sessionDurationAvg      Int?
  riskScore               Decimal?
  securityIncidents       Int      @default(0)
  metrics                 Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, analysisDate])
  @@map("user_analytics")
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  sessionId     String?
  operationId   String?
  notificationType String
  eventType     String
  recipient     String
  subject       String?
  content       String?
  status        String   @default("pending") // 'pending', 'sent', 'delivered', 'failed'
  attempts      Int      @default(0)
  maxAttempts   Int      @default(3)
  scheduledAt   DateTime @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  errorMessage  String?
  responseData  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model WebhookEndpoint {
  id           String   @id @default(cuid())
  userId       String
  sessionId    String?
  url          String
  secretKey    String?
  eventTypes   String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastUsed     DateTime?
  successCount Int      @default(0)
  failureCount Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  session DelegationSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("webhook_endpoints")
}

model EncryptedBackup {
  id               String   @id @default(cuid())
  userId           String
  backupType       String   // 'wallet_mnemonic', 'delegation_keys', 'user_data'
  encryptedData    String
  encryptionMethod String
  encryptionKeyId  String?
  checksum         String?
  createdAt        DateTime @default(now())
  expiresAt        DateTime?
  downloadCount    Int      @default(0)
  lastAccessed     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("encrypted_backups")
}

model RecoveryCode {
  id                String   @id @default(cuid())
  userId            String
  codeHash          String
  codeType          String   // 'emergency_access', 'wallet_recovery', 'account_reset'
  isUsed            Boolean  @default(false)
  usedAt            DateTime?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  usageRestrictions Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recovery_codes")
}
