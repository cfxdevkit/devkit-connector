{
  "name": "@conflux-wallet/web-components",
  "version": "0.1.0",
  "description": "Web components for Conflux Dual Wallet System",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.esm.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "dev": "rollup -c --watch --environment NODE_ENV:development",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@conflux-wallet/types": "workspace:*",
    "@conflux-wallet/server": "workspace:*",
    "ethers": "^6.8.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/jest": "^29.5.5",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "rollup": "^4.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "conflux",
    "wallet",
    "delegation",
    "web-components",
    "custom-elements",
    "shadow-dom"
  ],
  "author": "Conflux Dual Wallet Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/conflux-wallet/dual-wallet-system"
  },
  "bugs": {
    "url": "https://github.com/conflux-wallet/dual-wallet-system/issues"
  },
  "homepage": "https://github.com/conflux-wallet/dual-wallet-system#readme"
}
