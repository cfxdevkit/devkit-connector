{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["db:migrate"],
      "cache": false
    },
    "db:reset": {
      "cache": false
    },
    "contracts:compile": {
      "cache": false
    },
    "contracts:deploy": {
      "dependsOn": ["contracts:compile"],
      "cache": false
    },
    "contracts:test": {
      "dependsOn": ["contracts:compile"],
      "cache": false
    },
    "codegen": {
      "cache": false
    }
  }
}
