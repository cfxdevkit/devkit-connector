{
  "name": "@conflux-devkit/core",
  "version": "1.0.0",
  "description": "Conflux Development Kit Core - Foundation types, constants, and utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "clean": "rm -rf dist",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "check:fix:unsafe": "biome check --write --unsafe src/",
    "checkpoint": "echo \"Checkpoint: @conflux-devkit/core - All checks passed\"",
    "generate:contracts": "wagmi generate --config src/contracts/templates/wagmi.config.ts",
    "watch:contracts": "wagmi generate --config src/contracts/templates/wagmi.config.ts --watch"
  },
  "dependencies": {
    "viem": "^2.43.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitest/ui": "^4.0.16",
    "@wagmi/cli": "^2.8.0",
    "c8": "^10.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "wagmi": "^3.1.0"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "core",
    "types",
    "utilities",
    "foundation"
  ],
  "author": "Conflux Development Team",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0"
}
