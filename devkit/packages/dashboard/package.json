{
  "name": "@conflux-devkit/dashboard",
  "version": "1.0.0",
  "description": "Conflux Development Kit Dashboard - Modern React dashboard with Mantine UI",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest --watch",
    "test:ci": "vitest --run --reporter=verbose",
    "clean": "rm -rf .next out",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "checkpoint": "echo \"Checkpoint: @conflux-devkit/dashboard - All checks passed\""
  },
  "dependencies": {
    "@conflux-devkit/core": "workspace:*",
    "@conflux-devkit/blockchain": "workspace:*",
    "@mantine/core": "^8.3.1",
    "@mantine/hooks": "^8.3.1",
    "@mantine/modals": "^8.3.1",
    "@mantine/notifications": "^8.3.1",
    "@mantine/spotlight": "^8.3.1",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.51.0",
    "@wagmi/connectors": "^2.0.0",
    "@wagmi/core": "^2.0.0",
    "axios": "^1.7.0",
    "connectkit": "^1.7.0",
    "next": "14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "viem": "^2.21.0",
    "wagmi": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/user-event": "^14.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^2.1.9",
    "c8": "^8.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.0",
    "jsdom": "^25.0.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "frontend",
    "react",
    "mantine",
    "nextjs"
  ],
  "author": "Conflux Development Team",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0"
}
