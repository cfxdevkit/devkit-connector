{
  "name": "@conflux-devkit/showcase-webapp",
  "version": "1.0.0",
  "description": "Showcase webapp demonstrating Conflux DevKit integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && mkdir -p dist/public && cp src/index.html dist/public/ && cp dist/index.js dist/public/ && cp dist/App.js dist/public/ && cp src/App.css dist/public/ && cp -r dist/components dist/public/ && mkdir -p dist/public/packages && cp -r ../core/dist dist/public/packages/core && cp -r ../blockchain/dist dist/public/packages/blockchain && cp -r ../state/dist dist/public/packages/state && cp -r ../ui-primitives/dist dist/public/packages/ui-primitives",
    "dev": "tsc && concurrently \"tsc --watch\" \"nodemon --watch dist --exec node dist/dev.js\"",
    "dev:simple": "tsc && node dist/dev.js",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest --watch",
    "test:ci": "vitest --run --reporter=verbose",
    "clean": "rm -rf dist",
    "lint": "biome check src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "check:fix:unsafe": "biome check --write --unsafe src/",
    "checkpoint": "echo \"Checkpoint: @conflux-devkit/showcase-webapp - All checks passed\""
  },
  "dependencies": {
    "@conflux-devkit/core": "workspace:*",
    "@conflux-devkit/blockchain": "workspace:*",
    "@conflux-devkit/node": "workspace:*",
    "@conflux-devkit/state": "workspace:*",
    "@conflux-devkit/ui-primitives": "workspace:*",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/supertest": "^6.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/ui": "^2.1.9",
    "c8": "^8.0.1",
    "supertest": "^7.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9",
    "@biomejs/biome": "^2.2.4",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "showcase",
    "demo",
    "webapp",
    "devkit"
  ],
  "author": "Conflux Development Team",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0"
}
