{
  "name": "@conflux-devkit/state",
  "version": "1.0.0",
  "description": "State management layer for Conflux DevKit with Zustand stores and live contract state",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "lint": "biome lint src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@conflux-devkit/blockchain": "workspace:*",
    "@conflux-devkit/core": "workspace:*",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "immer": "^10.0.3",
    "tiny-secp256k1": "^2.2.4",
    "viem": "^2.37.6",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "state-management",
    "zustand",
    "react",
    "devkit"
  ],
  "author": "Conflux DevKit Team",
  "license": "MIT"
}
