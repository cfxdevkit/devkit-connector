{
  "name": "@conflux-devkit/state",
  "version": "1.0.0",
  "description": "State management layer for Conflux DevKit with Zustand stores and live contract state",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "clean": "rm -rf dist",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "check:fix:unsafe": "biome check --write --unsafe src/",
    "format": "biome format --write src/",
    "lint": "biome lint src/"
  },
  "dependencies": {
    "@conflux-devkit/blockchain": "workspace:*",
    "@conflux-devkit/core": "workspace:*",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "immer": "^10.0.3",
    "tiny-secp256k1": "^2.2.4",
    "viem": "^2.37.6",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^20.10.0",
    "@vitest/ui": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^24.0.0",
    "tsx": "^4.20.5",
    "tsup": "^8.0.2",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "state-management",
    "zustand",
    "react",
    "devkit"
  ],
  "author": "Conflux DevKit Team",
  "license": "MIT"
}
