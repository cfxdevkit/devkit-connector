{
  "name": "@conflux-devkit/ui-components",
  "version": "1.0.0",
  "description": "Vanilla web components for Conflux DevKit UI",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@conflux-devkit/core": "workspace:*",
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "tsup": "^8.0.0",
    "@biomejs/biome": "^2.2.4"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "ui",
    "components",
    "web-components",
    "vanilla",
    "lit",
    "devkit"
  ],
  "author": "Conflux Development Team"
}
