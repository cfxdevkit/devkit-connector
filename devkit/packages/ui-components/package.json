{
  "name": "@conflux-devkit/ui-components",
  "version": "1.0.0",
  "description": "Vanilla web components for Conflux DevKit UI",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "type-check": "tsc --noEmit",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "check:fix:unsafe": "biome check --write --unsafe src/",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "dependencies": {
    "@conflux-devkit/core": "workspace:*",
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "tsup": "^8.0.0",
    "@biomejs/biome": "^2.2.4",
    "@vitest/ui": "^2.1.8",
    "c8": "^8.0.1",
    "vitest": "^2.1.8",
    "@open-wc/testing": "^4.0.0",
    "@open-wc/testing-helpers": "^3.0.0"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "ui",
    "components",
    "web-components",
    "vanilla",
    "lit",
    "devkit"
  ],
  "author": "Conflux Development Team"
}
