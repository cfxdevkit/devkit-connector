{
  "name": "@conflux-devkit/ui-primitives",
  "version": "1.0.0",
  "description": "React primitives and data hooks for Conflux DevKit UI components",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "check:fix:unsafe": "biome check --write --unsafe src/",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@conflux-devkit/core": "workspace:*",
    "@conflux-devkit/state": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7",
    "immer": "^10.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.10.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/ui": "^3.2.4",
    "c8": "^10.1.3",
    "jsdom": "^23.0.0",
    "typescript": "^5.3.0",
    "tsup": "^8.0.0",
    "@biomejs/biome": "^2.2.4",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "ui",
    "react",
    "primitives",
    "hooks",
    "context",
    "devkit"
  ],
  "author": "Conflux Development Team"
}
