{
  "name": "conflux-monorepo",
  "version": "1.0.0",
  "description": "Conflux development tools and utilities monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm run generate:contracts && pnpm -r run build",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "dev": "pnpm run start:full-stack",
    "start:full-stack": "concurrently --kill-others-on-fail \"pnpm run start:server\" \"pnpm run start:frontend-mantine\"",
    "start:conflux-node": "cd packages/conflux-local-node && pnpm run dev",
    "start:server": "cd server && ESPACE_RPC_URL=http://localhost:8545 pnpm run dev",
    "start:frontend": "cd frontend && pnpm run dev",
    "start:frontend-mantine": "cd frontend-mantine && pnpm run dev",
    "install:all": "pnpm install",
    "conflux-node": "pnpm run start --filter @conflux-local/node",
    "conflux-node:dev": "pnpm run dev --filter @conflux-local/node",
    "generate:contracts": "node scripts/generate-contract-config.cjs",
    "contracts:sync": "pnpm run generate:contracts",
    "postinstall": "pnpm run generate:contracts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "conflux",
    "blockchain",
    "development",
    "monorepo",
    "node",
    "evm",
    "core"
  ],
  "author": "Conflux Development Team",
  "license": "MIT",
  "dependencies": {
    "@xcfx/node": "^0.6.0",
    "cive": "^0.8.1"
  }
}
