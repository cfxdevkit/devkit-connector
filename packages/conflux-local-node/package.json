{
  "name": "@conflux-local/node",
  "version": "1.0.0",
  "description": "Standalone local Conflux node using @xcfx/node for development and testing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "conflux-node": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node dist/cli.js dev",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "node dist/test.js"
  },
  "dependencies": {
    "@xcfx/node": "^0.6.0",
    "@xcfx/node-darwin-arm64": "0.6.0",
    "@xcfx/node-darwin-x64": "0.6.0",
    "@xcfx/node-linux-arm64-gnu": "0.6.0",
    "@xcfx/node-linux-x64-gnu": "^0.6.0",
    "@xcfx/node-win32-x64-msvc": "0.6.0",
    "bip32": "^5.0.0",
    "bip39": "^3.1.0",
    "chalk": "^5.6.2",
    "cive": "^0.8.1",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.3",
    "ora": "^9.0.0",
    "tiny-secp256k1": "^2.2.4",
    "viem": "^2.43.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "conflux",
    "node",
    "development",
    "testing",
    "blockchain",
    "evm",
    "core",
    "local"
  ],
  "author": "Conflux Local Node",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
