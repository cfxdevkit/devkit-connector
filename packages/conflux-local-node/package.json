{
  "name": "@conflux-local/node",
  "version": "1.0.0",
  "description": "Standalone local Conflux node using @xcfx/node for development and testing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "conflux-node": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node dist/cli.js dev",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "node dist/test.js"
  },
  "dependencies": {
    "@xcfx/node": "^0.6.0",
    "@xcfx/node-darwin-arm64": "0.6.0",
    "@xcfx/node-darwin-x64": "0.6.0",
    "@xcfx/node-linux-arm64-gnu": "0.6.0",
    "@xcfx/node-linux-x64-gnu": "^0.6.0",
    "@xcfx/node-win32-x64-msvc": "0.6.0",
    "bip32": "^4.0.0",
    "bip39": "^3.0.4",
    "chalk": "^4.1.2",
    "cive": "^0.8.1",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.1.1",
    "ora": "^5.4.1",
    "tiny-secp256k1": "^2.2.1",
    "viem": "^2.37.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.1",
    "@types/node": "^20.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "conflux",
    "node",
    "development",
    "testing",
    "blockchain",
    "evm",
    "core",
    "local"
  ],
  "author": "Conflux Local Node",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
